# YOLO Trainer 环境变量配置

# ===========================================
# 数据库配置
# ===========================================
POSTGRES_DB=yolo_trainer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/yolo_trainer

# ===========================================
# Redis 配置
# ===========================================
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# ===========================================
# MinIO 配置
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET=yolo-trainer

# ===========================================
# 应用配置
# ===========================================
SECRET_KEY=your_secret_key_generate_with_openssl_rand_base64_32
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ===========================================
# GPU 配置
# ===========================================
CUDA_VISIBLE_DEVICES=0

# ===========================================
# 训练配置
# ===========================================
MAX_CONCURRENT_TRAININGS=2
DEFAULT_MODEL_PATH=/models/pretrained
TRAINING_TIMEOUT=86400

# ===========================================
# 文件上传配置
# ===========================================
MAX_UPLOAD_SIZE=1073741824  # 1GB
ALLOWED_EXTENSIONS=jpg,jpeg,png,bmp,zip

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/yolo-trainer/app.log
