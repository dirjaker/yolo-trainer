# YOLO Trainer 环境变量配置
# 复制此文件为 .env 并修改实际值

# ===========================================
# 应用配置
# ===========================================
APP_NAME=YOLO Trainer
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-in-production

# ===========================================
# JWT 认证
# ===========================================
JWT_SECRET_KEY=your-secret-key-generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 数据库配置
# ===========================================
# SQLite (开发):
DATABASE_URL=sqlite+aiosqlite:///./yolo_trainer.db
# PostgreSQL (生产):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/yolo_trainer

# ===========================================
# Redis / Celery 配置
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# MinIO 对象存储 (可选)
# ===========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=yolo-trainer

# ===========================================
# 服务器端口
# ===========================================
# FastAPI 监听端口 (通过 uvicorn --port 传入，此处仅供参考)
API_HOST=0.0.0.0
API_PORT=10003

# ===========================================
# 部署配置
# ===========================================
DEPLOY_HOST=0.0.0.0
DEPLOY_PORT_START=8080
TORCHSERVE_MANAGEMENT_PORT=8081

# ===========================================
# 文件上传配置
# ===========================================
MAX_UPLOAD_SIZE_MB=2048
UPLOAD_DIR=/data/uploads
MODEL_DIR=/data/models
TRAINING_DIR=/data/training

# ===========================================
# GPU 配置
# ===========================================
CUDA_VISIBLE_DEVICES=0

# ===========================================
# CORS 配置
# ===========================================
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/yolo-trainer/app.log
